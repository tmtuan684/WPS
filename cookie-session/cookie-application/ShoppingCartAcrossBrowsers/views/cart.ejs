<!DOCTYPE html>
<html lang="en">
<head>
    <title>Cart</title>

    <!-- Bootstrap CSS -->
    <link 
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" 
        rel="stylesheet"
    >
</head>

<body class="bg-light">
    <!-- Navigation Bar -->
    <%- include('./partials/nav') %>

    <div class="container py-4">
        <h1 class="mb-4">Your Cart</h1>

        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Manufacturer</th>
                    <th>Price</th>
                    <th style="width:120px;">Quantity</th>
                    <th>Total</th>
                    <th style="width:160px;">Actions</th>
                </tr>
            </thead>

            <tbody>
                <% let total = 0 %>
                <% cart.forEach(item => {
                    total += item.product.price * item.quantity;
                    const pid = item.product.id || item.product.name.replace(/\s+/g, '-').toLowerCase();
                    const updateFormId = `update-form-${pid}`;
                %>

                <tr>
                    <td>
                        <img src="<%= item.product.photo %>"
                             alt="<%= item.product.name %>"
                             width="60"
                             class="rounded">
                    </td>

                    <td><%= item.product.name %></td>
                    <td><%= item.product.category %></td>
                    <td><%= item.product.manufacturer %></td>
                    <td>$<%= item.product.price %></td>

                    <!-- Quantity: visible input associated with update form -->
                    <td>
                        <input 
                            type="number" 
                            name="qty" 
                            form="<%= updateFormId %>" 
                            value="<%= item.quantity %>" 
                            class="form-control form-control-sm text-center" 
                            min="0"
                            style="width: 80px;"
                        >
                    </td>

                    <!-- Total price -->
                    <td>$<%= (item.product.price * item.quantity).toFixed(2) %></td>

                    <!-- Actions -->
                    <td>
                        <form id="<%= updateFormId %>" method="POST" action="/cart/<%= item.product.id || item.product.name %>">
                            <button type="submit" class="btn btn-warning btn-sm w-100 mb-1">Update</button>
                        </form>

                        <form method="POST" action="/cart/<%= item.product.id || item.product.name %>/delete">
                            <button type="submit" class="btn btn-danger btn-sm w-100">Delete</button>
                        </form>
                    </td>
                </tr>

                <% }) %>
            </tbody>

            <tfoot class="fw-bold">
                <tr>
                    <td colspan="6" class="text-end">Total:</td>
                    <td>$<%= total.toFixed(2) %></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>

        <!-- Checkout area -->
        <div class="d-flex justify-content-between align-items-center mt-3">
            <a href="/" class="btn btn-outline-secondary">Continue shopping</a>

            <!-- If cart is empty, disable checkout -->
            <% if (!cart || cart.length === 0) { %>
                <button class="btn btn-primary" disabled>Checkout</button>
            <% } else { %>
                <a href="/checkout" class="btn btn-primary">Proceed to Checkout</a>
            <% } %>
        </div>
    </div>

    <!-- Bootstrap JS (optional) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>

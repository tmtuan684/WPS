<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Checkout</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
  <%- include('./partials/nav') %>

  <div class="container py-5">
    <h1 class="mb-4">Checkout — Review & Payment</h1>

    <!-- Order summary -->
    <div class="row">
      <div class="col-md-6">
        <div class="card mb-4">
          <div class="card-header fw-bold">Shipping information</div>
          <div class="card-body">
            <form method="POST" action="/checkout">
              <div class="mb-3">
                <label class="form-label">Full name</label>
                <input name="fullname" class="form-control" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Email</label>
                <input name="email" type="email" class="form-control" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Address</label>
                <input name="address" class="form-control" required>
              </div>

              <div class="mb-3">
                <label class="form-label">City</label>
                <input name="city" class="form-control" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Postal code</label>
                <input name="postal" class="form-control" required>
              </div>

              <!-- Payment simulation -->
              <div class="card mt-3">
                <div class="card-header fw-bold">Payment (simulation)</div>
                <div class="card-body">
                  <p class="text-muted">This demo simulates payment. No real payment is processed.</p>
                  <div class="mb-3">
                    <label class="form-label">Card number</label>
                    <input name="card" class="form-control" placeholder="4242 4242 4242 4242" required>
                  </div>
                  <div class="row">
                    <div class="col">
                      <input name="expiry" class="form-control" placeholder="MM/YY" required>
                    </div>
                    <div class="col">
                      <input name="cvc" class="form-control" placeholder="CVC" required>
                    </div>
                  </div>
                </div>
              </div>

              <div class="mt-4 d-flex justify-content-between">
                <a href="/cart" class="btn btn-outline-secondary">Back to Cart</a>
                <button type="submit" class="btn btn-success">Place Order (Simulate)</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Right column: cart summary -->
      <div class="col-md-6">
        <div class="card mb-3">
          <div class="card-header fw-bold">Order summary</div>
          <div class="card-body">
            <% let subtotal = 0 %>
            <% if (!cart || cart.length === 0) { %>
              <p class="text-muted">Your cart is empty.</p>
            <% } else { %>
              <ul class="list-group list-group-flush mb-3">
                <% cart.forEach(item => { 
                  const line = item.product.price * item.quantity;
                  subtotal += line;
                %>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                      <div class="fw-bold"><%= item.product.name %></div>
                      <small class="text-muted"><%= item.quantity %> × $<%= item.product.price %></small>
                    </div>
                    <div>$<%= line.toFixed(2) %></div>
                  </li>
                <% }) %>
              </ul>

              <dl class="row">
                <dt class="col-8 text-end">Subtotal</dt>
                <dd class="col-4 text-end">$<%= subtotal.toFixed(2) %></dd>

                <dt class="col-8 text-end">Shipping</dt>
                <dd class="col-4 text-end">$5.00</dd>

                <dt class="col-8 text-end">Total</dt>
                <dd class="col-4 text-end fw-bold">$<%= (subtotal + 5).toFixed(2) %></dd>
              </dl>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS (optional) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Delete Student</title>

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body { padding-top: 1.5rem; padding-bottom: 2rem; }
    .form-card { max-width: 720px; margin: 0 auto; }
    .delete-text { color: #d9534f; font-weight: 600; }
  </style>
</head>
<body>
  <div class="container">

    <!-- Header -->
    <header class="d-flex align-items-center justify-content-between mb-4">
      <h1 class="h3 mb-0 text-danger">Delete Student</h1>
      <a href="/students" class="btn btn-outline-secondary">Back to List</a>
    </header>

    <!-- Delete Confirmation Card -->
    <div class="card form-card shadow-sm">
      <div class="card-body">

        <p class="delete-text mb-4">
          Are you sure you want to delete this student?
        </p>

        <!-- Display student details (read-only) -->
        <div class="mb-3">
          <strong>First name:</strong> <%= student.firstName %><br>
          <strong>Last name:</strong> <%= student.lastName %><br>
          <strong>Email:</strong> <%= student.email %><br>
          <strong>Age:</strong> <%= student.age %><br>
          <strong>Major:</strong> <%= student.major %><br>
        </div>

        <!-- Delete Form -->
        <form action="/students/<%= student._id %>/delete" method="POST">
          <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-danger">
              Yes, Delete Student
            </button>

            <a href="/students" class="btn btn-outline-secondary">
              Cancel
            </a>
          </div>
        </form>

      </div>
    </div>

  </div>

  <!-- Bootstrap JS (Optional) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

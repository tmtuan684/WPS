<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Student</title>

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body { padding-top: 1.5rem; padding-bottom: 2rem; }
    .form-card { max-width: 820px; margin: 0 auto; }
  </style>
</head>
<body>
  <div class="container">

    <!-- Page Header -->
    <header class="d-flex align-items-center justify-content-between mb-4">
      <h1 class="h3 mb-0">Edit Student</h1>
      <a href="/students" class="btn btn-outline-secondary">Back to List</a>
    </header>

    <!-- Edit Form Card -->
    <div class="card form-card shadow-sm">
      <div class="card-body">

        <!-- Form (POST to /students/:id/edit) -->
        <form action="/students/<%= student._id %>/edit" method="POST" novalidate>

          <!-- Row 1 -->
          <div class="row g-3">
            <div class="col-md-6">
              <label for="firstName" class="form-label">First name</label>
              <input type="text"
                     class="form-control"
                     id="firstName"
                     name="firstName"
                     value="<%= student.firstName %>"
                     required>
            </div>

            <div class="col-md-6">
              <label for="lastName" class="form-label">Last name</label>
              <input type="text"
                     class="form-control"
                     id="lastName"
                     name="lastName"
                     value="<%= student.lastName %>"
                     required>
            </div>

            <!-- Row 2 -->
            <div class="col-md-6">
              <label for="email" class="form-label">Email</label>
              <input type="email"
                     class="form-control"
                     id="email"
                     name="email"
                     value="<%= student.email %>"
                     required>
            </div>

            <div class="col-md-2">
              <label for="age" class="form-label">Age</label>
              <input type="number"
                     class="form-control"
                     id="age"
                     name="age"
                     min="0"
                     value="<%= student.age %>">
            </div>

            <div class="col-md-4">
              <label for="major" class="form-label">Major</label>
              <input type="text"
                     class="form-control"
                     id="major"
                     name="major"
                     value="<%= student.major %>">
            </div>
          </div>

          <!-- Buttons -->
          <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Update</button>
            <a href="/students" class="btn btn-outline-secondary">Cancel</a>
          </div>

        </form>

      </div>
    </div>

  </div>

  <!-- Bootstrap JS Bundle (optional) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

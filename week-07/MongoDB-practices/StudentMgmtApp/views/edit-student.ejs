<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Student</title>
</head>
<body>
  <h1>Edit Student</h1>

  <!-- 
    Replace STUDENT_ID and value="..." with actual data from DB.
    Example template-style comments are included.
  -->
  <form action="/students/STUDENT_ID" method="POST">
    <!-- If you use method-override, include this hidden input:
    <input type="hidden" name="_method" value="PUT">
    -->

    <div>
      <label for="firstName">First name:</label>
      <input
        type="text"
        id="firstName"
        name="firstName"
        value="Minh"   <!-- replace with existing firstName -->
        required
      >
    </div>

    <div>
      <label for="lastName">Last name:</label>
      <input
        type="text"
        id="lastName"
        name="lastName"
        value="Tran"   <!-- replace with existing lastName -->
        required
      >
    </div>

    <div>
      <label for="email">Email:</label>
      <input
        type="email"
        id="email"
        name="email"
        value="minh.tran@rmit.edu.vn"   <!-- replace with existing email -->
        required
      >
    </div>

    <div>
      <label for="age">Age:</label>
      <input
        type="number"
        id="age"
        name="age"
        min="0"
        value="21"   <!-- replace with existing age -->
      >
    </div>

    <div>
      <label for="major">Major:</label>
      <input
        type="text"
        id="major"
        name="major"
        value="Information Technology" <!-- replace with existing major -->
      >
    </div>

    <div>
      <button type="submit">Update</button>
      <a href="/students">Cancel</a>
    </div>
  </form>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Students</title>

  <!-- Bootstrap 5 (CSS only) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    /* small visual tweaks */
    body { padding-top: 1.5rem; padding-bottom: 2rem; }
    .table-actions a, .table-actions form { display: inline-block; margin-right: 0.25rem; }
    .no-data { color: #6c757d; }
  </style>
</head>
<body>
  <div class="container">

    <header class="d-flex align-items-center justify-content-between mb-4">
      <h1 class="h3 mb-0">Students</h1>
      <a href="/students/new" class="btn btn-success">Add New Student</a>
    </header>

    <div class="row mb-3">
      <div class="col-12 col-md-6">
        <div class="input-group">
          <span class="input-group-text" id="search-addon">Search</span>
          <input type="text" id="search" class="form-control" placeholder="Search by name or email..." aria-label="Search" aria-describedby="search-addon">
        </div>
      </div>

      <div class="col-12 col-md-6 text-md-end mt-2 mt-md-0">
        <small class="text-muted">Total: <strong id="count"><%= students ? students.length : 0 %></strong></small>
      </div>
    </div>

    <div class="table-responsive">
      <table id="studentsTable" class="table table-striped table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>First name</th>
            <th>Last name</th>
            <th>Email</th>
            <th>Age</th>
            <th>Major</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!students || students.length === 0) { %>
            <tr>
              <td colspan="6" class="text-center no-data py-4">
                No students found. <a href="/students/new" class="btn btn-sm btn-outline-primary ms-2">Add one</a>
              </td>
            </tr>
          <% } else { %>
            <% students.forEach(s => { %>
              <tr data-id="<%= s._id %>">
                <td><%= s.firstName %></td>
                <td><%= s.lastName %></td>
                <td><%= s.email %></td>
                <td><%= s.age ?? '' %></td>
                <td><%= s.major ?? '' %></td>
                <td class="text-center table-actions">
                  <a href="/students/<%= s._id %>/edit" class="btn btn-sm btn-primary">Edit</a>
                  <a href="/students/<%= s._id %>/delete" class="btn btn-sm btn-danger">Delete</a>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Optional: Bootstrap JS bundle (for dropdowns, modals if needed later) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Simple client-side search filter (keeps accessibility and performance)
    const searchInput = document.getElementById('search');
    const tbody = document.querySelector('#studentsTable tbody');
    const countEl = document.getElementById('count');

    function updateCount() {
      const visible = Array.from(tbody.rows).filter(r => r.style.display !== 'none').length;
      countEl.textContent = visible;
    }

    // Initialize count on page load
    updateCount();
  </script>
</body>
</html>

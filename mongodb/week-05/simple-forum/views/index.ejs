<%- include('partials/header', { title: 'Index' }) %>

<% posts.forEach(post => {
    %>
    <div class="post">
        <h2><%= post.title %></h2>
        <p><%= post.content %></p>
        <p>Author: <%= post.author.name %></p>
        <p>Topic: <%= post.topic.name %></p>
        <p>Categories: <%= post.categories.map(cat => cat.name).join(', ') %></p>
    </div>
    <hr>
    <% }); %>

<%- include('partials/footer') %>
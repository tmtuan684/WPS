<!-- Form to update an existing post -->
<%- include('header', { title: title }); %>
<form action="/posts/<%= post._id %>/edit" method="POST" class="container mt-4" style="max-width: 600px;">
    <div class="mb-3">
        <label for="title" class="form-label">Title:</label>
        <input type="text" id="title" name="title" value="<%= post.title %>" class="form-control" required>
    </div>
    <div class="mb-3">
        <label for="content" class="form-label">Content:</label>
        <textarea id="content" name="content" class="form-control" rows="5" required><%= post.content %></textarea>
    </div>
    <div class="mb-3">
        <label for="author" class="form-label">Author:</label>
        <select id="author" name="author" class="form-select" required>
            <% users.forEach(user => { %>
                <option value="<%= user._id %>" <%= user._id === post.author._id ? 'selected' : '' %>><%= user.name %> (<%= user.email %>)</option>
            <% }) %>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Update Post</button>
</form>
<%- include('footer') %>
<!-- Form to delete a post -->
<%- include('header', { title: title }) %>
<form action="/posts/<%= post._id %>/delete" method="POST" class="container mt-4" style="max-width: 600px;">
    <p class="mb-3">Are you sure you want to delete this post?</p>
    <div class="mb-3">
        <label for="title" class="form-label">Title:</label>
        <input type="text" id="title" name="title" value="<%= post.title %>" class="form-control" readonly>
    </div>
    <div class="mb-3">
        <label for="content" class="form-label">Content:</label>
        <textarea id="content" name="content" class="form-control" rows="5" readonly><%= post.content %></textarea>
    </div>
    <div class="mb-3">
        <label for="author" class="form-label">Author:</label>
        <input type="text" id="author" name="author" value="<%= post.author.name %> (<%= post.author.email %>)" class="form-control" readonly>
    </div>
    <button type="submit" class="btn btn-danger">Delete Post</button>
</form>
<%- include('footer') %>
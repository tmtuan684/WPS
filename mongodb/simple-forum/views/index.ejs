<%- include('partials/header', { title: 'Index' }) %>
<h1>Posts</h1>
<h2>Forum Topics</h2>
<ul>
    <% topics.forEach(topic => { %>
        <li><%= topic.name %> (<%= topic.numposts %> posts)</li>
    <% }); %>
</ul>

<h2>Recent Posts</h2>
<% posts.forEach(post => {
    %>
    <div class="post">
        <h3><%= post.title %></h3>
        <p><%= post.content %></p>
        <p>Author: <%= post.author.name %></p>
        <p>Topic: <%= post.topic.name %></p>
        <p>Categories: <%= post.categories.map(cat => cat.name).join(', ') %></p>
    </div>
    <hr>
    <% }); %>

<%- include('partials/footer') %>
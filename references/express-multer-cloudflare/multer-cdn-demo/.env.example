# Copy to .env and fill in real values. NEVER commit .env.
# Leave these blank to run the app in DEMO mode (files kept in memory, served
# by the app itself) so you can see the flow work without an R2 account.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=multer-demo-uploads
R2_PUBLIC_URL=

# Optional. Every host assigns its own port at runtime; 3000 is the local default.
PORT=3000

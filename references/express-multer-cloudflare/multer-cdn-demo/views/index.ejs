<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Multer + R2 Demo</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 640px; margin: 3rem auto; padding: 0 1rem; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; }
    .badge.demo { background: #fef3c7; color: #92400e; }
    .badge.r2 { background: #dcfce7; color: #166534; }
    form { margin: 1.5rem 0; display: flex; gap: .75rem; align-items: center; }
    img { margin-top: .75rem; border: 1px solid #e5e7eb; border-radius: 6px; }
    .err { color: #b91c1c; }
    code { background: #f3f4f6; padding: 1px 5px; border-radius: 3px; }
  </style>
</head>
<body>
  <h1>Upload an Image</h1>

  <% if (mode === 'demo') { %>
    <p><span class="badge demo">DEMO MODE</span> No R2 credentials set — files are held in memory and
      served by this app. Set the <code>R2_*</code> vars in <code>.env</code> to push to Cloudflare R2.</p>
  <% } else { %>
    <p><span class="badge r2">CLOUDFLARE R2</span> Files are buffered in memory, pushed to R2, and
      served from its CDN URL.</p>
  <% } %>

  <form action="/upload" method="POST" enctype="multipart/form-data">
    <input type="file" name="file" accept="image/jpeg, image/png" required>
    <button type="submit">Upload</button>
  </form>

  <% if (error) { %>
    <p class="err"><%= error %></p>
  <% } %>

  <% if (url) { %>
    <p>Uploaded! Served from <%= mode === 'r2' ? 'the CDN' : 'memory' %>:</p>
    <p><code><%= url %></code></p>
    <img src="<%= url %>" style="max-width:300px;">
  <% } %>
</body>
</html>

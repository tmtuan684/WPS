<%- include('header', { title: title }); %>

<div class="container">
    
        <% posts.forEach(post => { %>
            <div class="card" style="margin-bottom: 20px;">
                <div class="card-body">
                    <h5 class="card-title"><%= post.title %></h5>
                    <p class="card-text"><%= post.content %></p>
                    <p class="card-text"><small class="text-muted">Author: <%= post.author.name %> (<%= post.author.email %>)</small></p>
                </div>
                <div class="card-footer">
                    <a href="/posts/<%= post.id %>/edit" class="btn btn-primary">Update</a>
                    <a href="/posts/<%= post.id %>/delete" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this post?');">Delete</a>
                </div>
            </div>
        <% }) %>
    
</div>

<%- include('footer') %>
<!-- views/image.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Image Preview</title>
</head>
<body>
  <h1>Image Preview</h1>
  <h2>Name: <%= image.name %></h2>
  <img src='data: image; base64, <%= base64Image %>' alt='' width=600>
  <p>Content Type: <%= image.contentType %></p>
  <h3>Base64 Representation</h3>
  <textarea rows="10" cols="80"><%= base64Image %></textarea>
</body>
</html>
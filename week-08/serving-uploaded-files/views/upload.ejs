<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Basic File Upload</title>
</head>
<body>
    <h1>Upload a File</h1>
    <form action="http://127.0.0.1:3000/upload" method="POST" enctype="multipart/form-data">
        <input type="file" name="file" required>
        <button type="submit">Upload</button>
    </form>
</body>
</html>
